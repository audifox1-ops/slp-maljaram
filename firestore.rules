rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Data Model
    // ===============================================================
    // students: 이름, 생년월일, 소속학교, 장애유형, 치료영역, 일정 등
    // payment_records: 학생이름, 거래일자, 금액, 지원영역
    // annual_plans: 연간 치료 계획서
    // monthly_journals: 월별 치료 일지
    // ===============================================================

    // 학생 정보 필드 검증
    function isValidStudentData(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() < 50 &&
             data.birthDate is string && data.birthDate.size() > 0 && data.birthDate.size() < 20 &&
             data.school is string && data.school.size() > 0 && data.school.size() < 100 &&
             data.treatmentArea is string && data.treatmentArea.size() > 0 && data.treatmentArea.size() < 50 &&
             data.therapistName is string && data.therapistName.size() < 50;
    }

    // 결제 기록 필드 검증
    function isValidPaymentData(data) {
      return data.studentName is string && data.studentName.size() > 0 && data.studentName.size() < 50 &&
             data.transactionDate is string && data.transactionDate.size() > 0 &&
             data.treatmentArea is string && data.treatmentArea.size() > 0;
    }

    // 치료 영역 허용 목록
    function isAllowedTreatmentArea(area) {
      return area == '언어치료' || area == '미술치료' || area == '감각통합' || area == '인지치료' || area == '기타';
    }

    // 학생 컬렉션: 데이터 구조 검증 적용
    match /students/{studentId} {
      allow read: if true;
      allow create: if isValidStudentData(request.resource.data);
      allow update: if isValidStudentData(request.resource.data);
      allow delete: if true;
    }

    // 결제 기록 컬렉션: 데이터 구조 검증 적용
    match /payment_records/{recordId} {
      allow read: if true;
      allow create: if isValidPaymentData(request.resource.data);
      allow update: if isValidPaymentData(request.resource.data);
      allow delete: if true;
    }

    // 연간 계획서: 큰 데이터이므로 구조 검증 최소화
    match /annual_plans/{planId} {
      allow read: if true;
      allow write: if request.resource.data.keys().hasAll(['currentLevel', 'longTermGoals', 'monthlyGoals']);
    }

    // 월별 일지: 큰 데이터이므로 구조 검증 최소화
    match /monthly_journals/{journalId} {
      allow read: if true;
      allow write: if request.resource.data.keys().hasAll(['currentLevel', 'monthlyGoal', 'sessions', 'result']);
    }
  }
}
